    "str_specificDevicesFilterTooltip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled, the following events will be ignored:\n- Nintendo's Pro Controller (USB connected):\n    - Buttons since on/off events are continuously sent at high frequency even when nothing is pressed.\n    - Sticks since tilt events in random directions are continuously sent even when the stick is not moved at all."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜져있으면, 아래 이벤트들은 무시됩니다:\n- USB로 연결된 Nintendo Switch Pro 컨트롤러:\n    - 아무 버튼도 눌리지 않았음에도 빈번히 발생하는 버튼 꺼짐/켜짐 이벤트\n    - 스틱이 전혀 움직이지 않았음에도 발생하는 무작위 방향 스틱 기울임 이벤트 "
          }
        }
      }
    },
